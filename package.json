{
  "name": "foqa",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted personal FOQA system for G3X-equipped experimental aircraft",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:server": "npm run dev -w @foqa/server",
    "dev:web": "npm run dev -w @foqa/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "node-pg-migrate": {
      "glob": "^14.0.2"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
